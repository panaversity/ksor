{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig (the extended base) still sets baseUrl, which
    // TS 6 deprecates — silenced here until upstream drops it.
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": ["node_modules", "out", ".docusaurus", ".generated"]
}
