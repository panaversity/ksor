{
  "name": "@panaversity/ksor-content-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "The KSoR content gateway: the MCP door (search, outline, read) over a governed corpus — stateless Streamable HTTP. One gateway per record; this one serves content.",
  "license": "Apache-2.0",
  "author": "Panaversity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panaversity/ksor.git",
    "directory": "packages/content-gateway"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node copy-schema.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/pg": "^8.21.0",
    "hono": "4.13.2",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@panaversity/ksor-content": "workspace:*",
    "@panaversity/ksor-gateway-kit": "workspace:*",
    "@panaversity/ksor-postgres": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
