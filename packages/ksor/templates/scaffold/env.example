# Copy to .env — ksor reads it automatically, and .env is gitignored.
# A real environment variable always wins over this file, so CI and production
# keep their own values.

# The Postgres store, named by instance.md's database.dsn_env — uncomment the
# `database:` block there first. Needs the pgvector extension:
# CREATE EXTENSION vector;
# On a remote host prefer sslmode=verify-full, which states the TLS posture
# explicitly instead of relying on a driver default that is due to change.
KSOR_DB_URL=postgresql://user:password@host:5432/dbname

# The embedding provider key. instance.md defaults to gemini-embedding-001.
GEMINI_API_KEY=

# ── Who may ask ─────────────────────────────────────────────────────────────
# ONE variable, and its VALUE is the decision. `ksor serve` refuses to boot
# without either this or a configured SSO door — a server is never open by
# accident.
#
#   disabled-local   no auth, loopback only. A PUBLIC bind REFUSES, so copying
#                    this file into a hosting dashboard cannot quietly open your
#                    record to the internet. This is the dev posture.
#   disabled-public  no auth, and serve the whole record to anyone who can reach
#                    the port. A deliberate choice, correct for a genuinely
#                    public record or behind your own gateway. NOT a way to make
#                    a deploy go green.
#
# A container sets $PORT, so the door binds 0.0.0.0 — that is a public bind, and
# `disabled-local` will refuse there. That refusal is the point.
#
# For a real deployment, delete this line and configure the SSO door instead:
#   KSOR_SSO_URL=https://your-sso.example.com
#   KSOR_MCP_RESOURCE_URL=https://your-host.example.com/mcp
#   KSOR_JWT_ALLOWED_AUDIENCES=https://your-host.example.com/mcp
# The signing keys are DISCOVERED from your SSO's own metadata document —
# RFC 8414 (/.well-known/oauth-authorization-server), then OpenID Discovery
# (/.well-known/openid-configuration) — so Auth0, Okta, Entra, Keycloak,
# Cognito and Google all work unmodified. The boot line says which document
# answered and where the keys came from.
# Set this only to override discovery, or when your SSO publishes no metadata:
#   KSOR_JWKS_URL=https://your-sso.example.com/.well-known/jwks.json
KSOR_AUTH=disabled-local

# ── Sign-in on the WEBSITE (optional) ───────────────────────────────────────
# Names the reader in the navbar. It does NOT restrict reading: the site is a
# static export, so every published document is a file the host serves to
# whoever asks. To actually keep people out, see docs/deploying.md →
# "Keeping people out of the site".
#
# All three are required together, and are inlined at BUILD time — set them
# before the site build, not on the running site. Leave them unset and the
# sign-in control does not render at all.
#
# The issuer is the same authorization server the door names in KSOR_SSO_URL.
# Register a PUBLIC client (PKCE, no secret) whose redirect list contains the
# callback URL below, written out literally.
# NEXT_PUBLIC_KSOR_SSO_URL=https://your-sso.example.com
# NEXT_PUBLIC_KSOR_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_KSOR_OAUTH_REDIRECT_URI=https://your-site.example.com/auth/callback

# ── Production knobs ────────────────────────────────────────────────────────
# Unset is fine for a local run; each one matters once this serves for real.

# Snapshot-token signing keys, "kid=secret[,kid2=secret2]" (first is active).
# SET THIS ON ANY CONTAINER HOST. Unset mints an EPHEMERAL per-process key, so a
# generation pin issued by one instance is unverifiable by the next: `read`
# silently drops to the active generation and reports "refreshed (invalid)".
# It fails SOFT, so nothing errors and nothing logs — the only symptom is an
# agent reading a generation it did not search. Generate one with
# `openssl rand -hex 32`; the secret is used as literal text, never hex-decoded,
# and must be IDENTICAL across every replica.
# WITHOUT this the key is generated per PROCESS. Two deployments need it, not
# just one: any MULTI-REPLICA deploy (a token minted by one replica is refused
# by another), and any SCALE-TO-ZERO host, where a single replica mints a new
# key on every cold start — so a snapshot issued before a scale-down stops
# validating after it, even with one instance.
# KSOR_SNAPSHOT_KEYS=v1=<32+ random bytes>

# WHO this surface answers as: a comma list of audience identifiers, validated
# against the registry in .ksor/governance.yaml. It must always contain
# `public`, and unset means exactly `[public]`. A document is visible when its
# `ksor.audience` list and this one OVERLAP — there is no ranking, so
# `public,internal` is the reader who may see both, not a level.
# The same variable the site's per-audience build reads, so both surfaces mean
# the same thing. A build for anything wider than `public` belongs behind that
# audience's own access control, never on a public host.
# KSOR_AUDIENCE=public,internal

# The LOWEST trust tier this door will answer from: unverified (the default),
# machine-confirmed, or human-reviewed. A tier is derived from a document's
# `verified:` entries, never authored — unverified is the honest state of a
# record nobody has reviewed, and it is not a defect.
# A caller can raise this per call with the `min_trust_tier` argument; it can
# never be lowered below what is set here. Setting `human-reviewed` on a record
# with no reviews serves nothing at all, which is the point of setting it.
# KSOR_MIN_TRUST_TIER=unverified

# `ksor build` records drafts as hidden from every surface (the default) or
# shown on HUMAN surfaces only — a review build, marked noindex. Recorded in
# build.lock.json and in build_id; never set it for a build you deploy.
# KSOR_DRAFTS=show

# Bind. PORT is honoured too, for hosts that inject it.
# KSOR_MCP_HOST=127.0.0.1
# KSOR_MCP_PORT=8080

# Request caps and pool sizing.
# KSOR_MAX_INFLIGHT=64
# KSOR_MAX_BODY_BYTES=1000000
# KSOR_CONTENT_POOL_MAX=20       # ceiling under load
# By DEFAULT ksor holds NO open database connection when idle: the pool's
# minimum is 0 and an unused connection is closed after KSOR_CONTENT_POOL_IDLE_MS.
# Raising the minimum above 0 makes the server open that many connections at
# boot and KEEP them — a warm first request, paid for with sockets held open
# against your database. Opt in only if cold-start latency matters more.
# KSOR_CONTENT_POOL_MIN=0
# KSOR_CONTENT_POOL_IDLE_MS=10000
# KSOR_DRAIN_TIMEOUT_MS=8000     # hard deadline on shutdown; stay under the ~10s
#                                 a scale-to-zero runtime allows before SIGKILL

# Public-door hardening. Both default to the safe posture; set them when a
# proxy or a browser client sits in front and you know the exact names.
#   KSOR_ALLOWED_HOSTS=records.example.com     Host header allow-list (DNS-rebind defence)
#   KSOR_ALLOWED_ORIGINS=https://app.example.com   browser Origin allow-list
# Naming the issuer adds one more check to every token, for one variable:
#   KSOR_SSO_ISSUER=https://your-sso.example.com

# Connection behaviour. Unset is right for almost everyone; these exist for a
# deployment that has measured something.
#   KSOR_DB_CONNECT_PER_REQUEST=1  close the connection when each call finishes,
#                                  instead of returning it to the pool. OFF by
#                                  default because the default measures better:
#                                  a quiet server already holds ZERO connections
#                                  (min 0 + a 10s idle window), and inside a
#                                  burst the handshake is paid once. Measured on
#                                  loopback: 2.58ms/call per-request against
#                                  0.13ms pooled, and a remote TLS endpoint
#                                  widens that. Turn it on where per-request
#                                  connection is genuinely cheaper — a local
#                                  pooler sidecar, or a runtime that reuses no
#                                  process between invocations.
#   KSOR_DB_POOLED_ENDPOINT=1     force "this DSN is a transaction pooler" when
#                                 the host name does not say so
#   KSOR_READ_RETRY_ATTEMPTS=5    retries for a read that fails at the CONNECTION
#                                 level — a waking serverless compute
#   KSOR_READ_RETRY_BACKOFF_S=1.0 linear backoff between those attempts

# Ingest safety. A corpus that shrinks by more than this FRACTION (0.15 = 15%)
# refuses to flip; KSOR_ALLOW_SHRINK=1 is how you say a big deletion is meant.
# KSOR_MAX_SHRINK=0.15
# KSOR_ALLOW_SHRINK=1

# Embedding timeouts and cache (tuning only; unset is sensible).
# KSOR_EMBED_TIMEOUT_S=30
# KSOR_QUERY_EMBED_TIMEOUT_S=10
# KSOR_EMBED_CACHE_MAX=1000
