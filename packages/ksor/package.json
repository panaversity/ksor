{
  "name": "@panaversity/ksor",
  "version": "0.0.0",
  "description": "Knowledge System of Record — the authoritative, governed source of knowledge that humans and AI agents operate from. Name reserved; implementation in progress.",
  "keywords": [
    "abstention",
    "citations",
    "documentation",
    "docusaurus",
    "governance",
    "knowledge-system-of-record",
    "mcp",
    "model-context-protocol",
    "provenance",
    "system-of-record"
  ],
  "homepage": "https://github.com/panaversity/ksor#readme",
  "bugs": {
    "url": "https://github.com/panaversity/ksor/issues"
  },
  "license": "Apache-2.0",
  "author": "Panaversity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panaversity/ksor.git",
    "directory": "packages/ksor"
  },
  "bin": {
    "ksor": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "publint": "publint"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
