{
  "name": "@panaversity/ksor",
  "version": "0.0.40",
  "description": "Knowledge System of Record — compile governed markdown into a static site for people and an MCP server for AI agents, with citations and measured abstention.",
  "keywords": [
    "abstention",
    "citations",
    "documentation",
    "fumadocs",
    "governance",
    "knowledge-system-of-record",
    "mcp",
    "model-context-protocol",
    "provenance",
    "system-of-record"
  ],
  "homepage": "https://github.com/panaversity/ksor#readme",
  "bugs": {
    "url": "https://github.com/panaversity/ksor/issues"
  },
  "license": "Apache-2.0",
  "author": "Panaversity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panaversity/ksor.git",
    "directory": "packages/ksor"
  },
  "bin": {
    "ksor": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "CHANGELOG.md",
    "NOTICE",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./gateway": {
      "types": "./dist/gateway.d.mts",
      "import": "./dist/gateway.mjs",
      "default": "./dist/gateway.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node copy-schema.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "publint": "publint"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/pg": "^8.21.0",
    "hono": "4.13.2",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@panaversity/ksor-content": "workspace:*",
    "@panaversity/ksor-content-gateway": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "^1.58.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
